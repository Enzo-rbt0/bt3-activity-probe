{
  "name": "bt3probe-server",
  "version": "0.2.0",
  "private": true,
  "description": "Backend de rede da sonda (F3). Só código e testes locais na F3-0: nada de deploy.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "mutacao": "node scripts/mutacao.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
